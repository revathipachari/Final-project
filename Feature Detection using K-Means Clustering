from sklearn.cluster import KMeans
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt
# Step 1: Select only extreme rain events
extreme_df = extreme_rain_events.copy()
# Step 2: Define features (X = other variables, y = precipitation)
feature_cols = [col for col in extreme_df.columns if col not in ['precipitation', 'time',
'latitude', 'longitude']]
X = extreme_df[feature_cols]
# Step 3: Normalize the features
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
# Step 4: Use Elbow Method to find optimal number of clusters
inertia = []
k_range = range(1, 11)
for k in k_range:
kmeans = KMeans(n_clusters=k, random_state=42)
kmeans.fit(X_scaled)
inertia.append(kmeans.inertia_)
# Step 5: Plot Elbow curve
plt.figure(figsize=(8, 5))
plt.plot(k_range, inertia, 'bo-')
plt.xlabel('Number of clusters (k)')
plt.ylabel('Inertia')
plt.title('Elbow Method to Determine Optimal k')
plt.grid(True)
plt.show()
